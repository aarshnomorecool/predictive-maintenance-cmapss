# Email alert settings. Copy this file to .env and fill it in.
# .env is gitignored, so your password never reaches GitHub.
#
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# Your normal Gmail password will NOT work.

ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your.project.account@gmail.com
ALERT_SMTP_PASSWORD=abcd efgh ijkl mnop

# One or more recipients, comma separated
ALERT_EMAIL_TO=you@example.com, teammate@example.com

# Link used in the email's "Open in the dashboard" button
DASHBOARD_URL=http://127.0.0.1:8050
